{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor", "schedule:weekly"],
  "timezone": "UTC",
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Security overrides in pnpm-workspace.yaml stay within the major their parent asks for",
      "matchPackageNames": ["path-to-regexp", "postcss-selector-parser"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
