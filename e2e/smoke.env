# Settings for the smoke test's throwaway install. None of these is a real secret.
PORT=3300
APP_URL=http://localhost:3300
MAILPIT_PORT=8325
POSTGRES_PASSWORD=smoke-test
AUTH_SECRET=smoke-test-secret-that-is-at-least-32-characters
ENCRYPTION_KEYS=1:BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
# The default, set so CI can check that an optional setting reaches the app (#148).
BLOCK_PRIVATE_NETWORKS=false
# The DNS records the smoke test's Sending Domain, acme.example, is checked
# against, since it has no real DNS (DEV_DNS_RECORDS, for development only).
DEV_DNS_RECORDS='{"mailquilt._domainkey.acme.example":{"txt":["v=DKIM1; k=rsa; p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDwIRP/UC3SBsEmGqZ9ZJW3/DkM"]},"_dmarc.acme.example":{"txt":["v=DMARC1; p=reject"]},"acme.example":{"txt":["v=spf1 -all"]}}'
