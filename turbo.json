{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "api-worker#dev": {
      "dependsOn": ["dashboard#build"],
      "cache": false,
      "persistent": true
    },
    "server#dev": {
      "dependsOn": ["dashboard#build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["transit"],
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    }
  }
}
