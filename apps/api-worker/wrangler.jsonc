{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mailquilt-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  // The dashboard's build output, from `pnpm --filter dashboard build`.
  // Any path that isn't a file gets index.html, whoever asks, so every API
  // route must be listed in `run_worker_first` to reach the Worker.
  "assets": {
    "directory": "../dashboard/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      // Used by `wrangler dev`. Override it with
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres",
    },
  ],
}
