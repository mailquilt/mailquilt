{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mailquilt-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  // The dashboard's build output, from `pnpm --filter dashboard build`.
  // Any path that isn't a file gets index.html, whoever asks, unless it
  // matches `run_worker_first` (ADR 0004).
  "assets": {
    "directory": "../dashboard/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/api/*",
      "/preferences",
      "/preferences/*",
      "/unsubscribe",
      "/unsubscribe/*",
    ],
  },
  // A Campaign's batches. Create the queue once with `wrangler queues create
  // mailquilt`. Each delivery is one batch of up to 100 emails, so it has a
  // consumer invocation, and its 15-minute limit, to itself (ADR 0014). One
  // consumer runs at a time, as pg-boss does on Node, so a send never opens
  // more than one connection to the Provider's server.
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "mailquilt" }],
    // A failed batch is delivered again up to QUEUE_RETRIES (5) times, each
    // after twice the wait of the last (`queueRetryDelaySeconds` in core).
    "consumers": [
      {
        "queue": "mailquilt",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 5,
      },
    ],
  },
  // Every minute: forward queue messages a request couldn't (ADR 0014).
  // Every day at 03:00 UTC: make delivery events' coming monthly partitions.
  "triggers": {
    "crons": ["* * * * *", "0 3 * * *"],
  },
  // AUTH_SECRET and ENCRYPTION_KEYS are secrets: `wrangler secret put
  // AUTH_SECRET`, or `.dev.vars` for `wrangler dev`. So is
  // SYSTEM_MAILER_SMTP_PASSWORD, when the System Mailer is set here rather
  // than on the instance settings page (see `Env` in src/index.ts).
  "vars": {
    "APP_URL": "http://localhost:8787",
  },
  // Create the config with its query cache off, or reads come back up to a
  // minute old: `wrangler hyperdrive create mailquilt --caching-disabled
  // --connection-string=…`.
  // `pnpm --filter api-worker deploy` applies migrations before deploying,
  // through DATABASE_URL: a direct connection to the database Hyperdrive
  // points at.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      // Used by `wrangler dev`. Override it with
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres",
    },
  ],
}
